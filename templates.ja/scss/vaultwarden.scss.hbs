/**** START Static Vaultwarden の変更 ****/
/* これを拡張するすべてのセレクタを1つに結合します */
%vw-hide {
  display: none !important;
}

/* ブラウザの開発ツールで結合されたスタイルを検索できるようにします（headタグ内を確認） */
.vw-hide,
head {
  @extend %vw-hide;
}

/* サブスクリプションページのタブを非表示 */
bit-nav-item[route="settings/subscription"] {
  @extend %vw-hide;
}

/* Free Bitwarden Families へのリンクを非表示 */
a[href$="/settings/sponsored-families"] {
  @extend %vw-hide;
}

/* SSO の `Email` 入力フィールドを非表示 */
{{#if (not sso_enabled)}}
.vw-email-sso {
  @extend %vw-hide;
}
{{/if}}

/* デフォルト/続行の `Email` 入力フィールドを非表示 */
{{#if sso_enabled}}
.vw-email-continue {
  @extend %vw-hide;
}
{{/if}}

/* ログインページの `Continue` ボタンを非表示 */
{{#if sso_enabled}}
.vw-continue-login {
  @extend %vw-hide;
}
{{/if}}

/* ログインページの `Enterprise Single Sign-On` ボタンを非表示 */
{{#if (webver ">=2025.5.1")}}
{{#if (not sso_enabled)}}
.vw-sso-login {
  @extend %vw-hide;
}
{{/if}}
{{else}}
app-root ng-component > form > div:nth-child(1) > div > button[buttontype="secondary"].\!tw-text-primary-600:nth-child(4) {
  @extend %vw-hide;
}
{{/if}}

/* `Log in with passkey` 設定を非表示 */
app-user-layout app-password-settings app-webauthn-login-settings {
  @extend %vw-hide;
}
/* ログインページの Log in with passkey を非表示 */
{{#if (webver ">=2025.5.1")}}
.vw-passkey-login {
  @extend %vw-hide;
}
{{else}}
app-root ng-component > form > div:nth-child(1) > div > button[buttontype="secondary"].\!tw-text-primary-600:nth-child(3) {
  @extend %vw-hide;
}
{{/if}}

/* 上記で非表示にした2つのボタンに続く「または」テキストを非表示 */
{{#if (webver ">=2025.5.1")}}
{{#if (or (not sso_enabled) sso_only)}}
.vw-or-text {
  @extend %vw-hide;
}
{{/if}}
{{else}}
app-root ng-component > form > div:nth-child(1) > div:nth-child(3) > div:nth-child(2) {
  @extend %vw-hide;
}
{{/if}}

/* ログインページの `Other` ボタンを非表示 */
{{#if (or (not sso_enabled) sso_only)}}
.vw-other-login {
  @extend %vw-hide;
}
{{/if}}

/* 組織設定の二要素認証メニューを非表示 */
bit-nav-item[route="settings/two-factor"],
a[href$="/settings/two-factor"] {
  @extend %vw-hide;
}

/* 組織プランを非表示 */
app-organization-plans > form > bit-section:nth-child(2) {
  @extend %vw-hide;
}

/* コレクション管理フォームを非表示 */
app-org-account form.ng-untouched:nth-child(5) {
  @extend %vw-hide;
}

/* 組織レポートから 'Member Access' レポートカードを非表示 */
app-org-reports-home > app-report-list > div.tw-inline-grid > div:nth-child(6) {
  @extend %vw-hide;
}

/* 二段階ログイン画面のデバイス確認フォームを非表示 */
app-security > app-two-factor-setup > form {
  @extend %vw-hide;
}

/* サポートされていないカスタムロールオプションを非表示 */
bit-dialog div.tw-ml-4:has(bit-form-control input),
bit-dialog div.tw-col-span-4:has(input[formcontrolname*="access"], input[formcontrolname*="manage"]) {
  @extend %vw-hide;
}

/* 折りたたまれたメニューアイコンを Vaultwarden に変更 */
bit-nav-logo bit-nav-item a:before {
  content: "";
  background-image: url("../images/icon-white.svg");
  background-repeat: no-repeat;
  background-position: center center;
  height: 32px;
  display: block;
}
bit-nav-logo bit-nav-item .bwi-shield {
  @extend %vw-hide;
}
/* ユーザー設定ページのデバイスログイン保護ボタンを非表示 */
app-user-layout app-danger-zone button:nth-child(1) {
  @extend %vw-hide;
}

/* サポートされていない転送メールエイリアスオプションを非表示 */
ng-dropdown-panel div.ng-dropdown-panel-items div:has(> [title="Firefox Relay"]) {
  @extend %vw-hide;
}
ng-dropdown-panel div.ng-dropdown-panel-items div:has(> [title="DuckDuckGo"]) {
  @extend %vw-hide;
}
/**** END Static Vaultwarden の変更 ****/
/**** START Dynamic Vaultwarden の変更 ****/
{{#if signup_disabled}}
/* ウェブボールト 2025.1.2 以降、サインアップが無効の場合、サインアップボタンは非表示になります。
   ウェブボールトが /api/config エンドポイントをチェックするためです。
   クライアントはこのエンドポイントを約1時間キャッシュする傾向があるため、変更が反映されるまでに時間がかかる場合があります。
   ボタンが表示されるべきでないときに表示されるのを防ぐため、このスタイルを数バージョンにわたって維持します */
/* ログイン画面の登録リンクを非表示 */
{{#if (webver "<2025.3.0")}}
app-login form div + div + div + div + hr,
app-login form div + div + div + div + hr + p {
  @extend %vw-hide;
}
{{else}}
app-root a[routerlink="/signup"] {
  @extend %vw-hide;
}
{{/if}}
{{/if}}

{{#if remember_2fa_disabled}}
/* 2FAトークンを30日間記憶するチェックボックスを非表示 */
app-two-factor-auth > form > bit-form-control {
  @extend %vw-hide;
}
{{/if}}

{{#unless mail_2fa_enabled}}
/* メールが有効でない場合、`Email` 2FA を非表示 */
.providers-2fa-1 {
  @extend %vw-hide;
}
{{/unless}}

{{#unless yubico_enabled}}
/* YubiKey OTP セキュリティキーが有効でない場合、`YubiKey OTP security key` 2FA を非表示 */
.providers-2fa-3 {
  @extend %vw-hide;
}
{{/unless}}

{{#unless webauthn_2fa_supported}}
/* Passkey がサポートされていない場合、`Passkey` 2FA を非表示 */
.providers-2fa-7 {
  @extend %vw-hide;
}
{{/unless}}

{{#unless emergency_access_allowed}}
/* 緊急アクセスが許可されていない場合、非表示 */
bit-nav-item[route="settings/emergency-access"] {
  @extend %vw-hide;
}
{{/unless}}

{{#unless sends_allowed}}
/* Sends が許可されていない場合、非表示 */
bit-nav-item[route="sends"] {
  @extend %vw-hide;
}
{{/unless}}

{{#unless password_hints_allowed}}
/* パスワードヒントが許可されていない場合、非表示 */
a[routerlink="/hint"],
{{#if (webver "<2025.12.2")}}
app-change-password > form > .form-group:nth-child(5),
auth-input-password > form > bit-form-field:nth-child(4) {
{{else}}
.vw-password-hint {
{{/if}}
  @extend %vw-hide;
}
{{/unless}}
/**** End Dynamic Vaultwarden の変更 ****/
